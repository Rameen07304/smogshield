  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default outlined action: white fill, strong hairline, 6px radius.",
      "html": "<button class=\"ds-btn\">Refresh</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;height:36px;padding:0 14px;border:1px solid var(--line-strong,#c9cfcf);border-radius:var(--radius,6px);background:var(--surface,#fff);color:var(--text,#16191a);font:600 14px/1 var(--font,system-ui,sans-serif);cursor:pointer;transition:background-color .15s cubic-bezier(.2,.7,.2,1)}.ds-btn:hover{background:var(--surface-2,#eef0f0)}.ds-btn:active{transform:translateY(1px)}.ds-btn:focus-visible{outline:2px solid var(--accent,#0e6f68);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "The one coloured action: the simulated emergency trigger.",
      "html": "<button class=\"ds-btn-danger\">Trigger smog emergency</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;height:36px;padding:0 14px;border:1px solid var(--danger-line,#f0b8b2);border-radius:var(--radius,6px);background:var(--surface,#fff);color:var(--danger,#b42318);font:600 14px/1 var(--font,system-ui,sans-serif);cursor:pointer;transition:background-color .15s,border-color .15s}.ds-btn-danger:hover{background:var(--danger-weak,#fdecea);border-color:var(--danger,#b42318)}.ds-btn-danger:focus-visible{outline:2px solid var(--accent,#0e6f68);outline-offset:2px}"
    },
    {
