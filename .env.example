# SmogShield config. Copy to .env and edit:   cp .env.example .env
# .env is gitignored. NEVER put real secrets in this file, it is public.
# Everything here is optional: with no .env at all, the app runs on live data for Lahore
# and falls back to mock data if the network is down.

# ---------- Monitor agent (agents/monitor.py) ----------
# Live data comes from the Open-Meteo Air Quality API: free, NO API key needed.
# Data from Open-Meteo (https://open-meteo.com), based on CAMS ENSEMBLE data
# from the Copernicus Atmosphere Monitoring Service.

# Optional. Default: false. true = skip the network and always use data/mock_readings.json.
USE_MOCK=false

# Optional. Default: Lahore. Also: Karachi, Islamabad, Rawalpindi, Faisalabad, Multan,
# Peshawar, Quetta, Gujranwala, Sialkot, Sheikhupura, Kasur, Sahiwal, Sargodha,
# Bahawalpur (case-insensitive).
MONITOR_CITY=Lahore

# Optional. Default: unset (no forced scenario). Setting it FORCES mock data, even if USE_MOCK=false.
# One of: good, satisfactory, moderate, poor, very_poor, severe, spike
# Demo tip: MOCK_SCENARIO=severe forces a smog emergency on stage.
# MOCK_SCENARIO=severe

# Optional. Default: 10. Minutes to reuse a city's live reading before asking Open-Meteo
# again (it updates hourly). 0 = no cache, a request on every dashboard poll.
# LIVE_CACHE_MINUTES=10

# ---------- Forecast agent (agents/forecast.py) ----------
# Optional. Default: 30. Minutes to reuse a city's hourly forecast (next 4 days from Open-Meteo,
# a CAMS model estimate) before asking again. 0 = no cache.
# FORECAST_CACHE_MINUTES=30

# ---------- Analysis, Advisory agents ----------
# Optional. Default: false. When enabled, the advisory agent asks Groq for advice
# and validates the response. Rule-based advice remains the fallback for missing keys,
# network failures, timeouts, or invalid model output.
LLM_ADVISORY_ENABLED=false
GROQ_API_KEY=your_groq_api_key_here
# Optional. Default: openai/gpt-oss-20b
# GROQ_MODEL=openai/gpt-oss-20b

# ---------- Alert agent (agents/alert.py) ----------
# Optional. Default: 30. Minutes before the same location can be re-alerted at a lower or
# equal level, or for another spike. Rising to a worse level always alerts immediately.
# ALERT_COOLDOWN_MINUTES=30

# Optional. Default: 3. Hours after which the alert memory for a location is forgotten,
# so a level that stays high alerts again. (Memory is also cleared at startup whenever
# USE_MOCK or MOCK_SCENARIO forces mock data, so the demo always alerts.)
# ALERT_MEMORY_HOURS=3

# Optional. Leave as placeholders to use only the dashboard feed (var/alerts.json).
# Bot token: talk to @BotFather in Telegram, send /newbot, copy the token.
# Chat id: add the bot to your group, send a message, then open
#   https://api.telegram.org/bot<token>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional. Default: false. Alerts from mock data are marked [SIMULATION] and stay in the
# dashboard feed. Set true to also send them to Telegram (e.g. to test the bot).
# ALERT_SIMULATIONS_TO_TELEGRAM=false
